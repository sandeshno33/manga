    "act": 3,
    "ch": 3,
    "panel": "panel_024.jpg",
    "speaker": "Jinhyuk",
    "motion": "scroll-down",
    "sfx": "sfx_sword_slash.wav",
    "text": "These skeletons only spawn on a three-minute timer. Hit the joint, steal their bone armor buff, and keep moving.",
    "audio_file": "Solo_Max_Level_Newbie/audio/line_11.mp3",
    "duration_sec": 6.72,
    "duration_frames": 205,
    "pagePath": "Solo_Max_Level_Newbie/chapter_3/panels/panel_024.jpg"
  },
