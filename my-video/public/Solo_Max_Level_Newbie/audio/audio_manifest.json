    "panel": "panel_008.jpg",
    "speaker": "Narrator",
    "motion": "pan-spread-left",
    "sfx": null,
    "text": "Stepping onto the first floor, Jinhyuk skipped the crowded starter plains and dived into the subterranean catacombs.",
